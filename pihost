  r /= 255; g /= 255; b /= 255;
  const mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2;
  if (mx === mn) return [0, 0, l];
  const d = mx - mn, s = l > .5 ? d / (2 - mx - mn) : d / (mx + mn);
  const hh = mx === r ? (g - b) / d + (g < b ? 6 : 0) : mx === g ? (b - r) / d + 2 : (r - g) / d + 4;
  return [hh * 60, s, l];
}
// Rend une couleur lisible sur le fond : on garde la teinte, on normalise saturation et luminosité.
function accentFrom(r, g, b) {
  const [hh, s] = rgbToHsl(r, g, b);
  if (s < .18) return null;
  const light = matchMedia("(prefers-color-scheme: light)").matches;
  return `${Math.round(hh)} ${Math.round(Math.max(s, .6) * 100)}% ${light ? 48 : 66}%`;
}
function accentFromCss(css) {
  const probe = h("i"); probe.style.color = css; document.body.append(probe);
  const m = getComputedStyle(probe).color.match(/[\d.]+/g); probe.remove();
  return m ? accentFrom(+m[0], +m[1], +m[2]) : null;
}
function accentFromImage(img) {
  try {
    const n = 24, c = document.createElement("canvas"); c.width = c.height = n;
    const x = c.getContext("2d", { willReadFrequently: true });
    x.drawImage(img, 0, 0, n, n);
    const d = x.getImageData(0, 0, n, n).data;
    let r = 0, g = 0, b = 0, w = 0;
    for (let i = 0; i < d.length; i += 4) {
      if (d[i + 3] < 128) continue;
      const mx = Math.max(d[i], d[i + 1], d[i + 2]), mn = Math.min(d[i], d[i + 1], d[i + 2]);
      const sat = mx ? (mx - mn) / mx : 0, lum = (mx + mn) / 510;
      const wt = sat * sat * (lum > .12 && lum < .92 ? 1 : .05);
      r += d[i] * wt; g += d[i + 1] * wt; b += d[i + 2] * wt; w += wt;
    }
    return w > 1.5 ? accentFrom(r / w, g / w, b / w) : null;
  } catch { return null; }
}

/* ---------- rendu ---------- */
function makeCard(app, i) {
  const el = h("a", "card");
  el.href = `https://${app.host}/`;
  el.target = "_blank"; el.rel = "noopener";
  el.style.setProperty("--i", i);
  el.style.setProperty("--app-accent", `${hashHue(app.name)} 85% 68%`);

  const head = h("div", "head");
  const icon = h("div", "icon shimmer");
  icon.append(h("span", "mono", app.name.charAt(0).toUpperCase()));
  const names = h("div", "names");
  names.append(h("div", "name", app.name), h("div", "host", app.host));
  const status = h("span", "status pending");
  status.append(h("span", "dot"), h("span", "st", "…"));
  head.append(icon, names, status);

  const body = h("div", "body");
  const desc = h("div", "desc");
  body.append(desc);
  if (/^https:\/\/github\.com\//.test(app.repo || "")) {
    const gh = h("a", "gh");
    gh.href = app.repo.replace(/\.git$/, "");
    gh.target = "_blank"; gh.rel = "noopener";
    gh.title = "Code source";
    gh.innerHTML = GITHUB;
    gh.addEventListener("click", (e) => e.stopPropagation());
    body.append(gh);
  }

  el.append(head, body);
  el.addEventListener("pointermove", (e) => {
    const r = el.getBoundingClientRect();
    el.style.setProperty("--mx", `${e.clientX - r.left}px`);
    el.style.setProperty("--my", `${e.clientY - r.top}px`);
  });
  return { el, app, icon, status, desc, meta: false };
}

function setStatus(c, state, ms, code) {
  c.status.className = "status " + state;
  c.status.querySelector(".st").textContent = { up: `${ms} ms`, warn: `HTTP ${code}`, down: "hors ligne" }[state];
  c.el.classList.toggle("is-down", state === "down");
  if (state === "down" && !c.meta) {
    c.icon.classList.remove("shimmer");
    c.desc.innerHTML = "<em>Le service ne répond pas.</em>";
  }
}

/* ---------- sondes (via le proxy same-origin de Caddy) ---------- */
const probeBase = (app) => `/_probe/${encodeURIComponent(app.name)}/`;

// URL d'une ressource de l'app ; si elle est sur l'hôte de l'app, on passe par le proxy (same-origin).
function viaProbe(app, href) {
  let u;
  try { u = new URL(href, `https://${app.host}/`); } catch { return null; }
  if (u.host === app.host) return probeBase(app) + u.pathname.replace(/^\//, "") + u.search;
  return u.protocol === "https:" || u.protocol === "data:" ? u.href : null;
}

function iconCandidates(app, doc) {
  const scored = [];
  if (doc) {
    for (const l of doc.querySelectorAll('link[rel~="icon" i], link[rel~="apple-touch-icon" i], link[rel~="apple-touch-icon-precomposed" i], link[rel~="mask-icon" i]')) {
      const href = l.getAttribute("href"); if (!href) continue;
      const rel = (l.getAttribute("rel") || "").toLowerCase();
      const sizes = (l.getAttribute("sizes") || "").toLowerCase();
      let score = 32;
      if (rel.includes("mask-icon")) score = 1;          // monochrome, en dernier recours
      else if (sizes === "any" || /\.svg(\?|$)/i.test(href) || (l.getAttribute("type") || "").includes("svg")) score = 1000;
      else if (sizes) score = Math.max(...sizes.split(/\s+/).map((s) => parseInt(s, 10) || 0));
      else if (rel.includes("apple-touch")) score = 180;
      if (score > 256 && score < 1000) score = 256 - score / 1000; // pas besoin d'énormes images
      scored.push([score, href]);
    }
  }
  scored.sort((a, b) => b[0] - a[0]);
  const urls = scored.map(([, href]) => viaProbe(app, href)).filter(Boolean);
  urls.push(probeBase(app) + "favicon.ico");
  return [...new Set(urls)];
}

function loadImage(src) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.decoding = "async";
    img.onload = () => (img.naturalWidth > 0 ? resolve(img) : reject());
    img.onerror = reject;
    img.src = src;
  });
}

async function applyMeta(c, html) {
  const doc = html ? new DOMParser().parseFromString(html, "text/html") : null;
  const pick = (sel, attr) => doc?.querySelector(sel)?.getAttribute(attr)?.trim() || "";
  const title = doc?.querySelector("title")?.textContent.trim() || "";
  const desc = pick('meta[name="description" i]', "content") || pick('meta[property="og:description" i]', "content");
  const theme = pick('meta[name="theme-color" i]', "content");

  c.desc.textContent = "";
  if (title) { const b = h("span", null, title); b.style.color = "var(--fg)"; c.desc.append(b); }
  if (desc) c.desc.append((title ? " — " : "") + desc);

  if (theme) {
    const a = accentFromCss(theme);
    if (a) c.el.style.setProperty("--app-accent", a);
  }

  for (const src of iconCandidates(c.app, doc)) {
    try {
      const img = await loadImage(src);
      img.alt = "";
      c.icon.replaceChildren(img);
      requestAnimationFrame(() => img.classList.add("ok"));
      const a = accentFromImage(img);
      if (a) c.el.style.setProperty("--app-accent", a);
      break;
    } catch { /* candidat suivant */ }
  }
  c.icon.classList.remove("shimmer");
}

async function probe(c) {
  const ctl = new AbortController();
  const timer = setTimeout(() => ctl.abort(), TIMEOUT_MS);
  const t0 = performance.now();
  try {
    const r = await fetch(probeBase(c.app), { redirect: "manual", cache: "no-store", signal: ctl.signal });
    const ms = Math.round(performance.now() - t0);
    if ([502, 503, 504].includes(r.status)) return setStatus(c, "down");
    setStatus(c, r.status >= 500 ? "warn" : "up", ms, r.status);
    if (!c.meta) {
      c.meta = true;
      const html = r.type !== "opaqueredirect" && (r.headers.get("content-type") || "").includes("html") ? await r.text() : "";
      await applyMeta(c, html);
    }
  } catch {
    setStatus(c, "down");
  } finally {
    clearTimeout(timer);
  }
}

let busy = false;
async function probeAll() {
  if (busy) return;
  busy = true;
  await Promise.all([...cards.values()].map(probe));
  busy = false;
}

/* ---------- démarrage ---------- */
async function main() {
  let data;
  try {
    data = await (await fetch("apps.json", { cache: "no-store" })).json();
  } catch {
    $("#apps").innerHTML = '<div class="empty">Impossible de lire apps.json.</div>';
    return;
  }
  const apps = data.apps || [];
  const domain = data.domain || location.host;
  $("#domain").textContent = domain;
  document.title = domain;

  const root = $("#apps");
  if (!apps.length) {
    root.innerHTML = '<div class="empty">Rien ici pour l\'instant.<br><br><code>pihost add &lt;url-git&gt; &lt;sous-domaine&gt;</code></div>';
    return;
  }
  apps.forEach((app, i) => {
    const c = makeCard(app, i);
    cards.set(app.name, c);
    root.append(c.el);
  });
  probeAll();
  setInterval(() => { if (!document.hidden) probeAll(); }, REFRESH_MS);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) probeAll(); });
}

main();
</script>
</body>
</html>
DASHBOARD_HTML
}

# ---------------------------------------------------------------- commands --
cmd_init() {
  local domain="${1:-}" email="${2:-}"
  [[ -n "$domain" ]] || die "Usage : pihost init <domaine> [email]"
  need docker; need jq; need git
  mkdir -p "$APPS" "$SITES" "$WWW"
  DASHBOARD=""
  # shellcheck disable=SC1090
  [[ -f "$CONF" ]] && DASHBOARD="$(source "$CONF"; echo "${DASHBOARD:-}")"
  DOMAIN="$domain"; EMAIL="$email"
  write_config
  ensure_network
  dashboard_write
  write_caddyfile
  write_caddy_compose
  [[ -f "$SITES/_default.caddy" ]] || cat > "$SITES/_default.caddy" <<'CADDY'
# Réponse par défaut pour les hôtes inconnus en HTTP.
http:// {
    respond "pihost : aucune application sur cet hôte" 404
}
CADDY
  say "Démarrage de Caddy"
  caddy_compose up -d --quiet-pull 2>&1 | grep -v '^$' || true
  ok "pihost initialisé pour *.$domain (racine : $PIHOST_ROOT)"
  echo "  Pense à : DNS  *.$domain -> IP publique, et NAT 80/443 -> ce Pi."
}

cmd_add() {
  load_config
  local url="" sub="" svc="" port="" branch="" keep_ports=0 name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --service) svc="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --keep-ports) keep_ports=1; shift ;;
      -*) die "Option inconnue : $1" ;;
      *) if [[ -z "$url" ]]; then url="$1"; elif [[ -z "$sub" ]]; then sub="$1"; else die "Argument en trop : $1"; fi; shift ;;
    esac
  done
  [[ -n "$url" && -n "$sub" ]] || die "Usage : pihost add <url-git> <sous-domaine> [--service s] [--port p] [--branch b] [--name n] [--keep-ports]"

  local host; host="$(resolve_host "$sub")"
  [[ "$host" == "${DASHBOARD:-}" ]] && die "$host est utilisé par le tableau de bord (pihost dashboard off pour le libérer)"
  [[ -n "$name" ]] || name="$(derive_name "$sub")"
  local dir; dir="$(app_dir "$name")"
  [[ -d "$dir" ]] && die "L'application '$name' existe déjà. Utilise : pihost update $name, ou pihost remove $name"

  say "Clonage de $url"
  mkdir -p "$dir"
  local clone_args=(--depth 1)
  [[ -n "$branch" ]] && clone_args+=(--branch "$branch")
  git clone "${clone_args[@]}" "$url" "$(app_repo "$name")" 2>&1 | sed 's/^/  /' || { rm -rf "$dir"; die "Clonage impossible"; }

  local repo; repo="$(app_repo "$name")"
  if [[ ! -f "$repo/.env" && -f "$repo/.env.example" ]]; then
    cp "$repo/.env.example" "$repo/.env"
    warn ".env créé depuis .env.example — vérifie-le avec : pihost env $name"
  fi

  say "Détection du service web"
  local target; target="$(detect_target "$repo" "$svc" "$port")" || { rm -rf "$dir"; exit 1; }
  svc="${target% *}"; port="${target#* }"
  ok "Service '$svc' sur le port conteneur $port"

  printf 'NAME=%q\nURL=%q\nHOST=%q\nSERVICE=%q\nPORT=%q\nBRANCH=%q\nKEEP_PORTS=%q\n' \
    "$name" "$url" "$host" "$svc" "$port" "$branch" "$keep_ports" > "$(app_meta "$name")"
  write_override "$name" "$svc" "$keep_ports"

  if [[ "$keep_ports" == 1 ]]; then
    say "Vérification des ports hôte"
    ( check_host_ports "$repo" ) || { rm -rf "$dir"; exit 1; }
  fi

  ensure_network
  say "Construction et démarrage (docker compose up -d --build)"
  compose "$name" up -d --build --quiet-pull

  write_site "$name" "$host" "$port"
  if ! caddy_reload; then
    rm -f "$(app_site "$name")"
    die "Config Caddy invalide pour $host, site retiré. L'application tourne toujours (pihost logs $name)."
  fi
  dashboard_refresh
  ok "$name déployé : https://$host  ->  $svc:$port"
}

PIHOST_RAW_URL="https://raw.githubusercontent.com/Vitrixxl/pihost/main/pihost"

# Met à jour la CLI elle-même. Ne touche ni aux conteneurs, ni aux volumes, ni à la config.
cmd_self_update() {
  local self; self="$(readlink -f "${BASH_SOURCE[0]}")"
  local tmp; tmp="$(mktemp)"
  say "Téléchargement de la dernière version de pihost"
  curl -fsSL "$PIHOST_RAW_URL" -o "$tmp" || { rm -f "$tmp"; die "Téléchargement impossible"; }
  bash -n "$tmp" || { rm -f "$tmp"; die "Fichier téléchargé invalide, rien n'a été modifié"; }
  if cmp -s "$tmp" "$self"; then rm -f "$tmp"; ok "pihost est déjà à jour"; return; fi
  if [[ -w "$self" ]]; then install -m 0755 "$tmp" "$self"
  else sudo install -m 0755 "$tmp" "$self"; fi
  rm -f "$tmp"
  "$self" dashboard >/dev/null 2>&1 || true   # régénère la page avec la nouvelle version, si activée
  ok "pihost mis à jour ($self). Les applications et Caddy n'ont pas été touchés."
}

cmd_update() {
  local name="${1:-}"
  [[ -n "$name" ]] || { cmd_self_update; return; }
  load_config
  load_app "$name"
  say "git pull dans $(app_repo "$name")"
  git -C "$(app_repo "$name")" pull --ff-only 2>&1 | sed 's/^/  /'
  say "Reconstruction et redémarrage"
  compose "$name" up -d --build --quiet-pull
  dashboard_refresh
  ok "$name mis à jour : https://$HOST"
}

cmd_remove() {
  load_config
  local name="" purge=0
  for a in "$@"; do case "$a" in --volumes|-v) purge=1 ;; *) name="$a" ;; esac; done
  [[ -n "$name" ]] || die "Usage : pihost remove <nom> [--volumes]"
  load_app "$name"
  say "Arrêt de $name"
  local down=(down --remove-orphans); [[ $purge == 1 ]] && down+=(--volumes)
  compose "$name" "${down[@]}" 2>&1 | sed 's/^/  /' || true
  rm -f "$(app_site "$name")"
  caddy_reload || warn "Rechargement Caddy en échec"
  rm -rf "$(app_dir "$name")"
  dashboard_refresh
  ok "$name supprimé$( [[ $purge == 1 ]] && echo ' (volumes inclus)' )"
}

cmd_list() {
  load_config
  local any=0
  printf '%-14s %-32s %-14s %-12s %s\n' NOM HOTE CIBLE "PORTS HOTE" ETAT
  for meta in "$APPS"/*/app.env; do
    [[ -f "$meta" ]] || continue
    any=1
    # shellcheck disable=SC1090
    ( source "$meta"
      state="$(docker ps --filter "label=com.docker.compose.project=pihost-$NAME" \
                --filter "label=com.docker.compose.service=$SERVICE" --format '{{.Status}}' | head -1)"
      hp="-"; [[ "${KEEP_PORTS:-0}" == 1 ]] && hp="$(published_ports "$(app_repo "$NAME")" | tr '\n' ',' | sed 's/,$//')"
      printf '%-14s %-32s %-14s %-12s %s\n' "$NAME" "$HOST" "$SERVICE:$PORT" "${hp:--}" "${state:-arrêté}" )
  done
  [[ $any == 1 ]] || echo "(aucune application — pihost add <url-git> <sous-domaine>)"
}

cmd_logs()    { load_config; local n="${1:-}"; [[ -n "$n" ]] || die "Usage : pihost logs <nom>"; load_app "$n"; shift; compose "$n" logs -f --tail=100 "$@"; }
cmd_restart() { load_config; local n="${1:-}"; [[ -n "$n" ]] || die "Usage : pihost restart <nom>"; load_app "$n"; compose "$n" restart; ok "$n redémarré"; }
cmd_stop()    { load_config; local n="${1:-}"; [[ -n "$n" ]] || die "Usage : pihost stop <nom>"; load_app "$n"; compose "$n" stop; ok "$n arrêté"; }
cmd_start()   { load_config; local n="${1:-}"; [[ -n "$n" ]] || die "Usage : pihost start <nom>"; load_app "$n"; compose "$n" start; ok "$n démarré"; }

cmd_env() {
  load_config
  local n="" show=0
  for a in "$@"; do case "$a" in --show|-s|cat) show=1 ;; *) n="$a" ;; esac; done
  [[ -n "$n" ]] || die "Usage : pihost env <nom> [--show]   (édite .env puis redémarre ; --show l'affiche seulement)"
  load_app "$n"
  local f; f="$(app_repo "$n")/.env"
  if [[ $show == 1 ]]; then
    [[ -f "$f" ]] || die "Pas de .env pour $n ($f)"
    cat "$f"; return
  fi
  "${EDITOR:-vim}" "$f"
  say "Redémarrage pour prendre en compte .env"
  compose "$n" up -d --quiet-pull
  ok "$n redémarré"
}

cmd_dashboard() {
  load_config
  local arg="${1:-}"
  case "$arg" in
    "")
      [[ -n "${DASHBOARD:-}" ]] || die "Tableau de bord désactivé. Active-le : pihost dashboard <sous-domaine>   (@ = $DOMAIN)"
      dashboard_refresh
      ok "Tableau de bord régénéré : https://$DASHBOARD" ;;
    off|--off)
      DASHBOARD=""; write_config
      rm -f "$DASH_SITE"
      caddy_reload || warn "Rechargement Caddy en échec"
      ok "Tableau de bord désactivé" ;;
    -*) die "Usage : pihost dashboard [<sous-domaine>|@|off]" ;;
    *)
      local host m
      if [[ "$arg" == "@" ]]; then host="$DOMAIN"; else host="$(resolve_host "$arg")"; fi
      for m in "$APPS"/*/app.env; do
        [[ -f "$m" ]] || continue
        # shellcheck disable=SC1090
        ( source "$m"; [[ "$HOST" != "$host" ]] ) || die "$host est déjà utilisé par une application"
      done
      DASHBOARD="$host"; write_config
      dashboard_write
      # (Re)crée Caddy si besoin pour monter le dossier www.
      say "Mise à jour de Caddy"
      write_caddy_compose
      caddy_compose up -d --quiet-pull 2>&1 | grep -v '^$' || true
      local i; for i in 1 2 3 4 5; do caddy_reload && break; sleep 1; done
      ok "Tableau de bord : https://$host" ;;
  esac
}

cmd_caddy() {
  load_config
  case "${1:-}" in
    logs)   caddy_compose logs -f --tail=100 ;;
    reload) caddy_reload && ok "Caddy rechargé" ;;
    up)     ensure_network; mkdir -p "$WWW"; write_caddyfile; write_caddy_compose; caddy_compose up -d --quiet-pull; ok "Caddy démarré" ;;
    down)   caddy_compose down ;;
    *) die "Usage : pihost caddy logs|reload|up|down" ;;
  esac
}

cmd_help() {
  cat <<TXT
pihost — héberge des projets Docker Compose derrière Caddy, un sous-domaine chacun.

  pihost init <domaine> [email]                  Initialise et démarre Caddy
  pihost add <url-git> <sous-domaine> [options]  Clone, démarre, publie
        --service <nom>   service à exposer (auto si un seul expose un port)
        --port <port>     port conteneur (auto depuis ports:/expose:)
        --branch <b>      branche git
        --name <n>        nom interne (défaut : sous-domaine)
        --keep-ports      conserve les ports publiés sur l'hôte
  pihost update <nom>                            git pull + rebuild + redémarrage (rien n'est supprimé)
  pihost update                                  Met à jour pihost lui-même (sans toucher aux conteneurs)
  pihost remove <nom> [--volumes]                Arrête et supprime (+ données avec --volumes)
  pihost list                                    Liste les applications
  pihost logs|restart|stop|start <nom>
  pihost env <nom>                               Édite le .env (vim) puis redémarre
  pihost env <nom> --show                        Affiche le .env
  pihost caddy logs|reload|up|down
  pihost dashboard <sous-domaine|@>              Publie le tableau de bord des applications
  pihost dashboard [off]                         Le régénère, ou le désactive

Le sous-domaine peut être "cubix" (=> cubix.<domaine>) ou un FQDN complet.
Racine : $PIHOST_ROOT (variable PIHOST_ROOT)
TXT
}

case "${1:-help}" in
  init|add|update|remove|list|logs|restart|stop|start|env|caddy|dashboard) c="$1"; shift; "cmd_$c" "$@" ;;
  self-update) cmd_self_update ;;
  rm) shift; cmd_remove "$@" ;;
  ls) shift; cmd_list "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "Commande inconnue : $1 (pihost help)" ;;
esac

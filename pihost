#!/usr/bin/env bash
# pihost — déploie des projets Docker Compose derrière Caddy, un sous-domaine par projet.
set -euo pipefail

PIHOST_ROOT="${PIHOST_ROOT:-/srv/pihost}"
CONF="$PIHOST_ROOT/config"
APPS="$PIHOST_ROOT/apps"
CADDY_DIR="$PIHOST_ROOT/caddy"
SITES="$CADDY_DIR/sites"
NETWORK="pihost_web"
CADDY_CONTAINER="pihost-caddy"

# ---------------------------------------------------------------- helpers ---
say()  { printf '\033[1;34m▶\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✔\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m✘\033[0m %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "Commande manquante : $1"; }

load_config() {
  [[ -f "$CONF" ]] || die "pihost n'est pas initialisé. Lance : pihost init <domaine> [email]"
  # shellcheck disable=SC1090
  source "$CONF"
  [[ -n "${DOMAIN:-}" ]] || die "DOMAIN manquant dans $CONF"
}

app_dir()   { echo "$APPS/$1"; }
app_meta()  { echo "$APPS/$1/app.env"; }
app_repo()  { echo "$APPS/$1/repo"; }
app_over()  { echo "$APPS/$1/override.yaml"; }
app_site()  { echo "$SITES/$1.caddy"; }

load_app() {
  local name="$1"
  [[ -f "$(app_meta "$name")" ]] || die "Application inconnue : $name (voir : pihost list)"
  # shellcheck disable=SC1090
  source "$(app_meta "$name")"
}

# Trouve le fichier compose du dépôt.
find_compose() {
  local dir="$1" f
  for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
    [[ -f "$dir/$f" ]] && { echo "$dir/$f"; return; }
  done
  return 1
}

# docker compose pour une app : base + override, projet nommé d'après l'app.
compose() {
  local name="$1"; shift
  local repo; repo="$(app_repo "$name")"
  local base; base="$(find_compose "$repo")" || die "Aucun fichier compose dans $repo"
  docker compose --project-name "pihost-$name" --project-directory "$repo" \
    -f "$base" -f "$(app_over "$name")" "$@"
}

caddy_compose() { docker compose --project-directory "$CADDY_DIR" "$@"; }

ensure_network() {
  docker network inspect "$NETWORK" >/dev/null 2>&1 || {
    say "Création du réseau docker $NETWORK"
    docker network create "$NETWORK" >/dev/null
  }
}

write_caddyfile() {
  {
    echo "{"
    [[ -n "${EMAIL:-}" ]] && echo "    email $EMAIL"
    echo "}"
    echo
    echo "import /etc/caddy/sites/*.caddy"
  } > "$CADDY_DIR/Caddyfile"
}

write_caddy_compose() {
  cat > "$CADDY_DIR/compose.yaml" <<'YAML'
services:
  caddy:
    image: caddy:2
    container_name: pihost-caddy
    restart: unless-stopped
    ports:
      - "${PIHOST_HTTP_PORT:-80}:80"
      - "${PIHOST_HTTPS_PORT:-443}:443"
      - "${PIHOST_HTTPS_PORT:-443}:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./sites:/etc/caddy/sites:ro
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - web

networks:
  web:
    name: pihost_web
    external: true

volumes:
  caddy_data:
  caddy_config:
YAML
}

caddy_reload() {
  say "Validation et rechargement de Caddy"
  if ! docker exec "$CADDY_CONTAINER" caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
    return 1
  fi
  docker exec "$CADDY_CONTAINER" caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1
}

# Résout le FQDN : "cubix" -> cubix.$DOMAIN ; "cubix.autre.fr" -> inchangé.
resolve_host() {
  local sub="$1"
  if [[ "$sub" == *.* ]]; then echo "$sub"; else echo "$sub.$DOMAIN"; fi
}

# Nom d'app dérivé du sous-domaine (première étiquette), sûr pour docker.
derive_name() {
  local n="${1%%.*}"
  n="$(echo "$n" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-')"
  [[ -n "$n" ]] || die "Impossible de dériver un nom depuis '$1'"
  echo "$n"
}

# Détecte service et port depuis `docker compose config`.
# Sortie : "service port" ; entrée : repo, service forcé (ou vide), port forcé (ou vide).
detect_target() {
  local repo="$1" want_svc="$2" want_port="$3"
  local base; base="$(find_compose "$repo")" || die "Aucun compose.yaml / docker-compose.yml dans le dépôt"
  local json
  json="$(docker compose --project-directory "$repo" -f "$base" config --format json 2>/dev/null)" \
    || die "docker compose config a échoué. Variables d'environnement manquantes ? (pihost env <nom>)"

  local svc="$want_svc"
  if [[ -z "$svc" ]]; then
    local all; all="$(jq -r '.services | keys[]' <<<"$json")"
    local exposed
    exposed="$(jq -r '.services | to_entries[] | select((.value.ports // []) != [] or (.value.expose // []) != []) | .key' <<<"$json")"
    local n_all n_exp
    n_all="$(wc -l <<<"$all")"; n_exp="$( [[ -n "$exposed" ]] && wc -l <<<"$exposed" || echo 0 )"
    if   [[ "$n_exp" -eq 1 ]]; then svc="$exposed"
    elif [[ "$n_all" -eq 1 ]]; then svc="$all"
    elif [[ "$n_exp" -gt 1 ]]; then
      die "Plusieurs services exposent un port ($(tr '\n' ' ' <<<"$exposed")). Précise --service <nom>"
    else
      die "Impossible de deviner le service web parmi : $(tr '\n' ' ' <<<"$all"). Précise --service et --port"
    fi
  fi
  jq -e --arg s "$svc" '.services[$s]' <<<"$json" >/dev/null || die "Service inconnu : $svc"

  local port="$want_port"
  if [[ -z "$port" ]]; then
    port="$(jq -r --arg s "$svc" '
      (.services[$s].ports // [])[0].target // (.services[$s].expose // [])[0] // empty
    ' <<<"$json" | sed 's#/.*##')"
  fi
  [[ -n "$port" ]] || die "Aucun port trouvé pour le service $svc. Précise --port <port conteneur>"
  echo "$svc $port"
}

# Ports hôte publiés par le compose du dépôt (uniquement utile avec --keep-ports).
published_ports() {
  local repo="$1"
  local base; base="$(find_compose "$repo")" || return 0
  docker compose --project-directory "$repo" -f "$base" config --format json 2>/dev/null \
    | jq -r '.services[] | (.ports // [])[] | .published // empty' | sed 's/-.*//' | grep -E '^[0-9]+$' | sort -u
}

# Refuse si un port hôte demandé est déjà occupé sur le Pi (docker ou autre).
check_host_ports() {
  local repo="$1" p who conflicts=""
  local used; used="$(ss -Hltn 2>/dev/null | awk '{print $4}' | sed 's/.*://' | sort -u)"
  for p in $(published_ports "$repo"); do
    grep -qx "$p" <<<"$used" || continue
    who="$(docker ps --format '{{.Names}} {{.Ports}}' | grep -E "[:.]$p->" | awk '{print $1}' | head -1)"
    conflicts+="  port $p : déjà utilisé par ${who:-un service hors docker}"$'\n'
  done
  [[ -z "$conflicts" ]] || die "Conflit de ports hôte, déploiement annulé :"$'\n'"$conflicts  Retire --keep-ports (Caddy n'en a pas besoin) ou change les ports dans le compose."
}

write_override() {
  local name="$1" svc="$2" keep_ports="$3"
  {
    echo "# Généré par pihost — ne pas éditer à la main."
    echo "services:"
    echo "  $svc:"
    echo "    networks:"
    echo "      default: {}"
    echo "      web:"
    echo "        aliases: [\"$name.pihost\"]"
    [[ "$keep_ports" == 1 ]] || echo "    ports: !reset []"
    echo "networks:"
    echo "  web:"
    echo "    name: $NETWORK"
    echo "    external: true"
  } > "$(app_over "$name")"
}

write_site() {
  local name="$1" host="$2" port="$3"
  cat > "$(app_site "$name")" <<CADDY
$host {
    reverse_proxy $name.pihost:$port
}
CADDY
}

# ---------------------------------------------------------------- commands --
cmd_init() {
  local domain="${1:-}" email="${2:-}"
  [[ -n "$domain" ]] || die "Usage : pihost init <domaine> [email]"
  need docker; need jq; need git
  mkdir -p "$APPS" "$SITES"
  printf 'DOMAIN=%q\nEMAIL=%q\n' "$domain" "$email" > "$CONF"
  ensure_network
  write_caddyfile
  write_caddy_compose
  [[ -f "$SITES/_default.caddy" ]] || cat > "$SITES/_default.caddy" <<'CADDY'
# Réponse par défaut pour les hôtes inconnus en HTTP.
http:// {
    respond "pihost : aucune application sur cet hôte" 404
}
CADDY
  say "Démarrage de Caddy"
  caddy_compose up -d --quiet-pull 2>&1 | grep -v '^$' || true
  ok "pihost initialisé pour *.$domain (racine : $PIHOST_ROOT)"
  echo "  Pense à : DNS  *.$domain -> IP publique, et NAT 80/443 -> ce Pi."
}

cmd_add() {
  load_config
  local url="" sub="" svc="" port="" branch="" keep_ports=0 name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --service) svc="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --keep-ports) keep_ports=1; shift ;;
      -*) die "Option inconnue : $1" ;;
      *) if [[ -z "$url" ]]; then url="$1"; elif [[ -z "$sub" ]]; then sub="$1"; else die "Argument en trop : $1"; fi; shift ;;
    esac
  done
  [[ -n "$url" && -n "$sub" ]] || die "Usage : pihost add <url-git> <sous-domaine> [--service s] [--port p] [--branch b] [--name n] [--keep-ports]"

  local host; host="$(resolve_host "$sub")"
  [[ -n "$name" ]] || name="$(derive_name "$sub")"
  local dir; dir="$(app_dir "$name")"
  [[ -d "$dir" ]] && die "L'application '$name' existe déjà. Utilise : pihost update $name, ou pihost remove $name"

  say "Clonage de $url"
  mkdir -p "$dir"
  local clone_args=(--depth 1)
  [[ -n "$branch" ]] && clone_args+=(--branch "$branch")
  git clone "${clone_args[@]}" "$url" "$(app_repo "$name")" 2>&1 | sed 's/^/  /' || { rm -rf "$dir"; die "Clonage impossible"; }

  local repo; repo="$(app_repo "$name")"
  if [[ ! -f "$repo/.env" && -f "$repo/.env.example" ]]; then
    cp "$repo/.env.example" "$repo/.env"
    warn ".env créé depuis .env.example — vérifie-le avec : pihost env $name"
  fi

  say "Détection du service web"
  local target; target="$(detect_target "$repo" "$svc" "$port")" || { rm -rf "$dir"; exit 1; }
  svc="${target% *}"; port="${target#* }"
  ok "Service '$svc' sur le port conteneur $port"

  printf 'NAME=%q\nURL=%q\nHOST=%q\nSERVICE=%q\nPORT=%q\nBRANCH=%q\nKEEP_PORTS=%q\n' \
    "$name" "$url" "$host" "$svc" "$port" "$branch" "$keep_ports" > "$(app_meta "$name")"
  write_override "$name" "$svc" "$keep_ports"

  if [[ "$keep_ports" == 1 ]]; then
    say "Vérification des ports hôte"
    ( check_host_ports "$repo" ) || { rm -rf "$dir"; exit 1; }
  fi

  ensure_network
  say "Construction et démarrage (docker compose up -d --build)"
  compose "$name" up -d --build --quiet-pull

  write_site "$name" "$host" "$port"
  if ! caddy_reload; then
    rm -f "$(app_site "$name")"
    die "Config Caddy invalide pour $host, site retiré. L'application tourne toujours (pihost logs $name)."
  fi
  ok "$name déployé : https://$host  ->  $svc:$port"
}

PIHOST_RAW_URL="https://raw.githubusercontent.com/Vitrixxl/pihost/main/pihost"

# Met à jour la CLI elle-même. Ne touche ni aux conteneurs, ni aux volumes, ni à la config.
cmd_self_update() {
  local self; self="$(readlink -f "${BASH_SOURCE[0]}")"
  local tmp; tmp="$(mktemp)"
  say "Téléchargement de la dernière version de pihost"
  curl -fsSL "$PIHOST_RAW_URL" -o "$tmp" || { rm -f "$tmp"; die "Téléchargement impossible"; }
  bash -n "$tmp" || { rm -f "$tmp"; die "Fichier téléchargé invalide, rien n'a été modifié"; }
  if cmp -s "$tmp" "$self"; then rm -f "$tmp"; ok "pihost est déjà à jour"; return; fi
  if [[ -w "$self" ]]; then install -m 0755 "$tmp" "$self"
  else sudo install -m 0755 "$tmp" "$self"; fi
  rm -f "$tmp"
  ok "pihost mis à jour ($self). Les applications et Caddy n'ont pas été touchés."
}

cmd_update() {
  local name="${1:-}"
  [[ -n "$name" ]] || { cmd_self_update; return; }
  load_config
  load_app "$name"
  say "git pull dans $(app_repo "$name")"
  git -C "$(app_repo "$name")" pull --ff-only 2>&1 | sed 's/^/  /'
  say "Reconstruction et redémarrage"
  compose "$name" up -d --build --quiet-pull
  ok "$name mis à jour : https://$HOST"
}

cmd_remove() {
  load_config
  local name="" purge=0
  for a in "$@"; do case "$a" in --volumes|-v) purge=1 ;; *) name="$a" ;; esac; done
  [[ -n "$name" ]] || die "Usage : pihost remove <nom> [--volumes]"
  load_app "$name"
  say "Arrêt de $name"
  local down=(down --remove-orphans); [[ $purge == 1 ]] && down+=(--volumes)
  compose "$name" "${down[@]}" 2>&1 | sed 's/^/  /' || true
  rm -f "$(app_site "$name")"
  caddy_reload || warn "Rechargement Caddy en échec"
  rm -rf "$(app_dir "$name")"
  ok "$name supprimé$( [[ $purge == 1 ]] && echo ' (volumes inclus)' )"
}

cmd_list() {
  load_config
  local any=0
  printf '%-14s %-32s %-14s %-12s %s\n' NOM HOTE CIBLE "PORTS HOTE" ETAT
  for meta in "$APPS"/*/app.env; do
    [[ -f "$meta" ]] || continue
    any=1
    # shellcheck disable=SC1090
    ( source "$meta"
      state="$(docker ps --filter "label=com.docker.compose.project=pihost-$NAME" \
                --filter "label=com.docker.compose.service=$SERVICE" --format '{{.Status}}' | head -1)"
      hp="-"; [[ "${KEEP_PORTS:-0}" == 1 ]] && hp="$(published_ports "$(app_repo "$NAME")" | tr '\n' ',' | sed 's/,$//')"
      printf '%-14s %-32s %-14s %-12s %s\n' "$NAME" "$HOST" "$SERVICE:$PORT" "${hp:--}" "${state:-arrêté}" )
  done
  [[ $any == 1 ]] || echo "(aucune application — pihost add <url-git> <sous-domaine>)"
}

cmd_logs()    { load_config; local n="${1:-}"; [[ -n "$n" ]] || die "Usage : pihost logs <nom>"; load_app "$n"; shift; compose "$n" logs -f --tail=100 "$@"; }
cmd_restart() { load_config; local n="${1:-}"; [[ -n "$n" ]] || die "Usage : pihost restart <nom>"; load_app "$n"; compose "$n" restart; ok "$n redémarré"; }
cmd_stop()    { load_config; local n="${1:-}"; [[ -n "$n" ]] || die "Usage : pihost stop <nom>"; load_app "$n"; compose "$n" stop; ok "$n arrêté"; }
cmd_start()   { load_config; local n="${1:-}"; [[ -n "$n" ]] || die "Usage : pihost start <nom>"; load_app "$n"; compose "$n" start; ok "$n démarré"; }

cmd_env() {
  load_config
  local n="" show=0
  for a in "$@"; do case "$a" in --show|-s|cat) show=1 ;; *) n="$a" ;; esac; done
  [[ -n "$n" ]] || die "Usage : pihost env <nom> [--show]   (édite .env puis redémarre ; --show l'affiche seulement)"
  load_app "$n"
  local f; f="$(app_repo "$n")/.env"
  if [[ $show == 1 ]]; then
    [[ -f "$f" ]] || die "Pas de .env pour $n ($f)"
    cat "$f"; return
  fi
  "${EDITOR:-vim}" "$f"
  say "Redémarrage pour prendre en compte .env"
  compose "$n" up -d --quiet-pull
  ok "$n redémarré"
}

cmd_caddy() {
  load_config
  case "${1:-}" in
    logs)   caddy_compose logs -f --tail=100 ;;
    reload) caddy_reload && ok "Caddy rechargé" ;;
    up)     ensure_network; write_caddyfile; write_caddy_compose; caddy_compose up -d --quiet-pull; ok "Caddy démarré" ;;
    down)   caddy_compose down ;;
    *) die "Usage : pihost caddy logs|reload|up|down" ;;
  esac
}

cmd_help() {
  cat <<TXT
pihost — héberge des projets Docker Compose derrière Caddy, un sous-domaine chacun.

  pihost init <domaine> [email]                  Initialise et démarre Caddy
  pihost add <url-git> <sous-domaine> [options]  Clone, démarre, publie
        --service <nom>   service à exposer (auto si un seul expose un port)
        --port <port>     port conteneur (auto depuis ports:/expose:)
        --branch <b>      branche git
        --name <n>        nom interne (défaut : sous-domaine)
        --keep-ports      conserve les ports publiés sur l'hôte
  pihost update <nom>                            git pull + rebuild + redémarrage (rien n'est supprimé)
  pihost update                                  Met à jour pihost lui-même (sans toucher aux conteneurs)
  pihost remove <nom> [--volumes]                Arrête et supprime (+ données avec --volumes)
  pihost list                                    Liste les applications
  pihost logs|restart|stop|start <nom>
  pihost env <nom>                               Édite le .env (vim) puis redémarre
  pihost env <nom> --show                        Affiche le .env
  pihost caddy logs|reload|up|down

Le sous-domaine peut être "cubix" (=> cubix.<domaine>) ou un FQDN complet.
Racine : $PIHOST_ROOT (variable PIHOST_ROOT)
TXT
}

case "${1:-help}" in
  init|add|update|remove|list|logs|restart|stop|start|env|caddy) c="$1"; shift; "cmd_$c" "$@" ;;
  self-update) cmd_self_update ;;
  rm) shift; cmd_remove "$@" ;;
  ls) shift; cmd_list "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "Commande inconnue : $1 (pihost help)" ;;
esac

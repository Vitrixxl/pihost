#!/usr/bin/env bash
# pihost — déploie des projets Docker Compose derrière Caddy, un sous-domaine par projet.
set -euo pipefail

PIHOST_ROOT="${PIHOST_ROOT:-/srv/pihost}"
CONF="$PIHOST_ROOT/config"
APPS="$PIHOST_ROOT/apps"
CADDY_DIR="$PIHOST_ROOT/caddy"
SITES="$CADDY_DIR/sites"
WWW="$CADDY_DIR/www"
DASH_SITE="$SITES/_dashboard.caddy"
NETWORK="pihost_web"
CADDY_CONTAINER="pihost-caddy"

# ---------------------------------------------------------------- helpers ---
say()  { printf '\033[1;34m▶\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✔\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m✘\033[0m %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "Commande manquante : $1"; }

load_config() {
  [[ -f "$CONF" ]] || die "pihost n'est pas initialisé. Lance : pihost init <domaine> [email]"
  # shellcheck disable=SC1090
  source "$CONF"
  [[ -n "${DOMAIN:-}" ]] || die "DOMAIN manquant dans $CONF"
}

write_config() {
  printf 'DOMAIN=%q\nEMAIL=%q\nDASHBOARD=%q\n' "$DOMAIN" "${EMAIL:-}" "${DASHBOARD:-}" > "$CONF"
}

app_dir()   { echo "$APPS/$1"; }
app_meta()  { echo "$APPS/$1/app.env"; }
app_repo()  { echo "$APPS/$1/repo"; }
app_over()  { echo "$APPS/$1/override.yaml"; }
app_site()  { echo "$SITES/$1.caddy"; }

load_app() {
  local name="$1"
  [[ -f "$(app_meta "$name")" ]] || die "Application inconnue : $name (voir : pihost list)"
  # shellcheck disable=SC1090
  source "$(app_meta "$name")"
}

# Trouve le fichier compose du dépôt.
find_compose() {
  local dir="$1" f
  for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
    [[ -f "$dir/$f" ]] && { echo "$dir/$f"; return; }
  done
  return 1
}

# docker compose pour une app : base + override, projet nommé d'après l'app.
compose() {
  local name="$1"; shift
  local repo; repo="$(app_repo "$name")"
  local base; base="$(find_compose "$repo")" || die "Aucun fichier compose dans $repo"
  docker compose --project-name "pihost-$name" --project-directory "$repo" \
    -f "$base" -f "$(app_over "$name")" "$@"
}

caddy_compose() { docker compose --project-directory "$CADDY_DIR" "$@"; }

ensure_network() {
  docker network inspect "$NETWORK" >/dev/null 2>&1 || {
    say "Création du réseau docker $NETWORK"
    docker network create "$NETWORK" >/dev/null
  }
}

write_caddyfile() {
  {
    echo "{"
    [[ -n "${EMAIL:-}" ]] && echo "    email $EMAIL"
    echo "}"
    echo
    echo "import /etc/caddy/sites/*.caddy"
  } > "$CADDY_DIR/Caddyfile"
}

write_caddy_compose() {
  cat > "$CADDY_DIR/compose.yaml" <<'YAML'
services:
  caddy:
    image: caddy:2
    container_name: pihost-caddy
    restart: unless-stopped
    ports:
      - "${PIHOST_HTTP_PORT:-80}:80"
      - "${PIHOST_HTTPS_PORT:-443}:443"
      - "${PIHOST_HTTPS_PORT:-443}:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - ./sites:/etc/caddy/sites:ro
      - ./www:/srv/www:ro
      - caddy_data:/data
      - caddy_config:/config
    networks:
      - web

networks:
  web:
    name: pihost_web
    external: true

volumes:
  caddy_data:
  caddy_config:
YAML
}

caddy_reload() {
  say "Validation et rechargement de Caddy"
  if ! docker exec "$CADDY_CONTAINER" caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
    return 1
  fi
  docker exec "$CADDY_CONTAINER" caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1
}

# Résout le FQDN : "cubix" -> cubix.$DOMAIN ; "cubix.autre.fr" -> inchangé.
resolve_host() {
  local sub="$1"
  if [[ "$sub" == *.* ]]; then echo "$sub"; else echo "$sub.$DOMAIN"; fi
}

# Nom d'app dérivé du sous-domaine (première étiquette), sûr pour docker.
derive_name() {
  local n="${1%%.*}"
  n="$(echo "$n" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-')"
  [[ -n "$n" ]] || die "Impossible de dériver un nom depuis '$1'"
  echo "$n"
}

# Détecte service et port depuis `docker compose config`.
# Sortie : "service port" ; entrée : repo, service forcé (ou vide), port forcé (ou vide).
detect_target() {
  local repo="$1" want_svc="$2" want_port="$3"
  local base; base="$(find_compose "$repo")" || die "Aucun compose.yaml / docker-compose.yml dans le dépôt"
  local json
  json="$(docker compose --project-directory "$repo" -f "$base" config --format json 2>/dev/null)" \
    || die "docker compose config a échoué. Variables d'environnement manquantes ? (pihost env <nom>)"

  local svc="$want_svc"
  if [[ -z "$svc" ]]; then
    local all; all="$(jq -r '.services | keys[]' <<<"$json")"
    local exposed
    exposed="$(jq -r '.services | to_entries[] | select((.value.ports // []) != [] or (.value.expose // []) != []) | .key' <<<"$json")"
    local n_all n_exp
    n_all="$(wc -l <<<"$all")"; n_exp="$( [[ -n "$exposed" ]] && wc -l <<<"$exposed" || echo 0 )"
    if   [[ "$n_exp" -eq 1 ]]; then svc="$exposed"
    elif [[ "$n_all" -eq 1 ]]; then svc="$all"
    elif [[ "$n_exp" -gt 1 ]]; then
      die "Plusieurs services exposent un port ($(tr '\n' ' ' <<<"$exposed")). Précise --service <nom>"
    else
      die "Impossible de deviner le service web parmi : $(tr '\n' ' ' <<<"$all"). Précise --service et --port"
    fi
  fi
  jq -e --arg s "$svc" '.services[$s]' <<<"$json" >/dev/null || die "Service inconnu : $svc"

  local port="$want_port"
  if [[ -z "$port" ]]; then
    port="$(jq -r --arg s "$svc" '
      (.services[$s].ports // [])[0].target // (.services[$s].expose // [])[0] // empty
    ' <<<"$json" | sed 's#/.*##')"
  fi
  [[ -n "$port" ]] || die "Aucun port trouvé pour le service $svc. Précise --port <port conteneur>"
  echo "$svc $port"
}

# Ports hôte publiés par le compose du dépôt (uniquement utile avec --keep-ports).
published_ports() {
  local repo="$1"
  local base; base="$(find_compose "$repo")" || return 0
  docker compose --project-directory "$repo" -f "$base" config --format json 2>/dev/null \
    | jq -r '.services[] | (.ports // [])[] | .published // empty' | sed 's/-.*//' | grep -E '^[0-9]+$' | sort -u
}

# Refuse si un port hôte demandé est déjà occupé sur le Pi (docker ou autre).
check_host_ports() {
  local repo="$1" p who conflicts=""
  local used; used="$(ss -Hltn 2>/dev/null | awk '{print $4}' | sed 's/.*://' | sort -u)"
  for p in $(published_ports "$repo"); do
    grep -qx "$p" <<<"$used" || continue
    who="$(docker ps --format '{{.Names}} {{.Ports}}' | grep -E "[:.]$p->" | awk '{print $1}' | head -1)"
    conflicts+="  port $p : déjà utilisé par ${who:-un service hors docker}"$'\n'
  done
  [[ -z "$conflicts" ]] || die "Conflit de ports hôte, déploiement annulé :"$'\n'"$conflicts  Retire --keep-ports (Caddy n'en a pas besoin) ou change les ports dans le compose."
}

write_override() {
  local name="$1" svc="$2" keep_ports="$3"
  {
    echo "# Généré par pihost — ne pas éditer à la main."
    echo "services:"
    echo "  $svc:"
    echo "    networks:"
    echo "      default: {}"
    echo "      web:"
    echo "        aliases: [\"$name.pihost\"]"
    [[ "$keep_ports" == 1 ]] || echo "    ports: !reset []"
    echo "networks:"
    echo "  web:"
    echo "    name: $NETWORK"
    echo "    external: true"
  } > "$(app_over "$name")"
}

write_site() {
  local name="$1" host="$2" port="$3"
  cat > "$(app_site "$name")" <<CADDY
$host {
    reverse_proxy $name.pihost:$port
}
CADDY
}

# ------------------------------------------------------------- dashboard ---
# URL web publique d'un dépôt git : retire les identifiants (https://token@...), convertit
# le SSH (git@host:chemin, ssh://) en https et les alias SSH (github.com-perso -> github.com).
public_url() {
  sed -E -e 's#^([a-z+]+://)[^/@]*@#\1#' \
         -e 's#^[^@/:]+@([^:/]+):#https://\1/#' \
         -e 's#^(git\+)?ssh://#https://#' \
         -e 's#^(https?://(github\.com|gitlab\.com|bitbucket\.org|codeberg\.org))-[^/]+/#\1/#' <<<"$1"
}

# Génère la page, apps.json et le site Caddy du tableau de bord (sans recharger Caddy).
# La page sonde chaque app via /_probe/<nom>/ : proxy same-origin vers le conteneur,
# ce qui donne l'état réel, le titre et le favicon sans souci de CORS.
dashboard_write() {
  [[ -n "${DASHBOARD:-}" ]] || return 0
  mkdir -p "$WWW" "$SITES"
  local meta probes=""
  local json
  json="$(for meta in "$APPS"/*/app.env; do
      [[ -f "$meta" ]] || continue
      # shellcheck disable=SC1090
      ( source "$meta"
        jq -n --arg name "$NAME" --arg host "$HOST" --arg repo "$(public_url "$URL")" \
          '{name:$name, host:$host, repo:$repo}' )
    done | jq -s --arg domain "$DOMAIN" --arg at "$(date -Iseconds)" \
      '{domain:$domain, generated:$at, apps:sort_by(.name)}')"
  printf '%s\n' "$json" > "$WWW/apps.json.tmp" && mv "$WWW/apps.json.tmp" "$WWW/apps.json"
  dashboard_html > "$WWW/index.html"

  for meta in "$APPS"/*/app.env; do
    [[ -f "$meta" ]] || continue
    # shellcheck disable=SC1090
    probes+="$( source "$meta"
      printf '    handle_path /_probe/%s/* {\n        reverse_proxy %s.pihost:%s {\n            header_up Host %s\n        }\n    }' \
        "$NAME" "$NAME" "$PORT" "$HOST" )"$'\n'
  done
  {
    echo "# Généré par pihost — tableau de bord (pihost dashboard)."
    echo "$DASHBOARD {"
    echo "    encode zstd gzip"
    echo "    header X-Robots-Tag noindex"
    printf '%s' "$probes"
    echo "    handle /_probe/* {"
    echo "        respond 404"
    echo "    }"
    echo "    handle {"
    echo "        header Cache-Control no-cache"
    echo "        root * /srv/www"
    echo "        file_server"
    echo "    }"
    echo "}"
  } > "$DASH_SITE"
}

# À appeler après tout changement d'applications. Sans effet si le tableau de bord est désactivé.
dashboard_refresh() {
  [[ -n "${DASHBOARD:-}" ]] || return 0
  dashboard_write
  caddy_reload || warn "Rechargement Caddy en échec (tableau de bord)"
}

